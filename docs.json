{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "ipcrazy Docs",
  "description": "Dynamic residential, static residential and static native proxies: setup, connection details, billing and the ipcrazy API.",
  "colors": {
    "primary": "#2F6FF0",
    "light": "#6FA0FF",
    "dark": "#2F6FF0"
  },
  "background": {
    "color": {
      "light": "#FFFFFF",
      "dark": "#091B36"
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://ipcrazy.com"
  },
  "favicon": "/favicon.svg",
  "api": {
    "playground": {
      "display": "interactive"
    },
    "examples": {
      "languages": ["curl", "python", "javascript"]
    }
  },
